# FAMAS STORE — systemd unit (бот + mini app, порт 4488 на 127.0.0.1)
# Ставится скриптом deploy/deploy.sh в /etc/systemd/system/famas-shop.service
[Unit]
Description=Famas Store bot+miniapp
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntuuser
WorkingDirectory=/home/ubuntuuser/famas-shop
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
MemoryHigh=250M
MemoryMax=350M

[Install]
WantedBy=multi-user.target
