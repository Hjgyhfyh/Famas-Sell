# FAMAS STORE — конфигурация (скопируй в .env и заполни)

# Токен бота от @BotFather (ОБЯЗАТЕЛЕН)
BOT_TOKEN=...

# Telegram id админов через запятую
ADMIN_IDS=927937870

# Username поддержки (без @)
SUPPORT_USERNAME=sigmatik323

# Порт HTTP-сервера (nginx проксирует /famas/ сюда)
PORT=4488

# Публичная база URL (без хвостового /)
PUBLIC_BASE=https://telepasta.ru/famas

# Источник VLESS-конфигов. Может начинаться с file: — тогда это локальный файл (для тестов)
SOURCE_URL=https://raw.githubusercontent.com/igareck/vpn-configs-for-russia/refs/heads/main/BLACK_VLESS_RUS_mobile.txt

# Период обновления источника, минут
FETCH_INTERVAL_MIN=10

# Цена за 1-й сервер региона, звёзд (Stars)
DEFAULT_PRICE_STARS=20

# Доплата за каждый доп. сервер того же региона, звёзд (Stars)
EXTRA_STARS=10

# Срок действия подписки, дней
DEFAULT_SUB_DAYS=30

# Бонус-звёзды за каждого приглашённого нового пользователя (реферальная программа)
REF_BONUS_STARS=10

# Путь к файлу БД SQLite
DB_PATH=./data/famas.db

# 1 = поднять только HTTP без бота (локальная проверка)
SKIP_BOT=0

# Username бота (без @)
BOT_USERNAME=FamasSellerBot

# ── SPEC-LOG: логи продаж в приватный канал + живая статистика ──
# ID приватного канала продаж. Бот должен быть его админом (post/edit/delete/pin).
# Пусто или 0 = логирование выключено (бот работает как раньше).
SALES_CHANNEL_ID=-1004297326871

# Через сколько минут самоудаляется сообщение о покупке в канале (удаление переживает рестарт бота)
SALE_LOG_TTL_MIN=60

# ── SPEC-QUALITY: фильтр качества серверов (продаём/выдаём только живые) ──
# Подстроки доменов заведомо ненадёжных хостов (free-хостинги, туннели), через запятую.
# Переопределяет дефолтный список. Пусто = использовать встроенный дефолт.
# HOST_BLACKLIST=up.railway.app,railway.app,onrender.com,render.com,herokuapp.com,glitch.me,repl.co,replit.dev,trycloudflare.com,ngrok.io,ngrok-free.app,serveo.net,localhost.run,loca.lt,cfargotunnel.com,workers.dev,pagekite.me,telebit.io

# TCP-проверка живости серверов после каждого обновления источника (1=вкл, 0=выкл)
HEALTHCHECK_ENABLED=1

# Таймаут одного TCP-подключения при проверке живости, мс
HEALTHCHECK_TIMEOUT_MS=4000

# Сколько хостов проверять одновременно (размер пула)
HEALTHCHECK_CONCURRENCY=24

# ── SPEC-HARDEN ч.1: стабильность выданного ключа ──
# Отдельный, более частый таймер healthcheck (минут): мёртвый сервер выпадает из живых за ≤ этого
# интервала, не дожидаясь FETCH_INTERVAL_MIN. Дефолт 3.
HEALTHCHECK_INTERVAL_MIN=3

# Заголовок подписки profile-update-interval (часы): как часто клиент (Happ/v2ray) перечитывает
# подписку и подтягивает актуальные живые серверы. Целое ≥1. Дефолт 1.
SUB_UPDATE_HOURS=1

# ── SPEC-HARDEN ч.2: защита выдачи /famas/s/:token ──
# Реальные VPN-клиенты (подстроки User-Agent, через запятую) — им отдаём base64-подписку.
# Пусто = встроенный дефолт (happ,v2ray,v2rayng,v2raytun,v2box,nekobox,sing-box,shadowrocket,clash,hiddify,…).
# VPN_UA_ALLOW=happ,v2ray,v2rayng,v2raytun,v2box,nekobox,nekoray,sing-box,sing_box,singbox,shadowrocket,streisand,clash,stash,loon,surge,karing,hiddify,foxray,sagernet,matsuri,ktor-client,ktor

# Явные браузеры/утилиты (подстроки User-Agent, через запятую) — им отдаём страницу-подсказку, а не конфиги.
# Пусто = встроенный дефолт. Пустой/незнакомый UA не режется (пропускается к подписке).
# BROWSER_UA_BLOCK=mozilla,chrome,safari,edg,curl,wget,python-requests,postmanruntime,go-http-client
